{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.RudrenduPaul/inferbench",
  "description": "Benchmarks local LLM inference speed (tokens/sec) on your own hardware via MCP tools.",
  "repository": {
    "url": "https://github.com/RudrenduPaul/InferBench",
    "source": "github"
  },
  "version": "0.1.7",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "inferbench-cli",
      "version": "0.1.7",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "inferbench-cli"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "script_name",
          "value": "inferbench-mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
